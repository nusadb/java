<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nusadb</groupId>
    <artifactId>nusadb-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>nusadb-hibernate6</artifactId>
  <packaging>jar</packaging>

  <name>NusaDB Hibernate 6 Dialect</name>
  <description>A Hibernate ORM 6.x dialect for NusaDB, built on the nusadb-jdbc driver</description>
  <url>https://github.com/nusadb/java</url>

  <scm>
    <connection>scm:git:https://github.com/nusadb/java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/nusadb/java.git</developerConnection>
    <url>https://github.com/nusadb/java</url>
  </scm>

  <!-- Compiled against Hibernate 6.6, the version Spring Boot 3.4 and 3.5 ship; HQL upsert
       (insert ... on conflict) needs its 6.5+ API. The dialect still runs on 6.4: `-Phibernate-6.4`
       runs the tests against a 6.4 runtime, where the 6.5+ code is never called. -->
  <properties>
    <hibernate.version>6.6.53.Final</hibernate.version>
    <hibernate.minimum.version>6.4.4.Final</hibernate.minimum.version>
  </properties>

  <dependencies>
    <!-- Hibernate is provided by the host application at runtime. -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>${hibernate.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- The NusaDB JDBC driver this dialect drives. -->
    <dependency>
      <groupId>com.nusadb</groupId>
      <artifactId>nusadb-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.nusadb</groupId>
      <artifactId>nusadb-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- The same compiled classes and tests, run on the oldest supported Hibernate. -->
    <profile>
      <id>hibernate-6.4</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.hibernate.orm:hibernate-core</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <additionalClasspathDependencies>
                <additionalClasspathDependency>
                  <groupId>org.hibernate.orm</groupId>
                  <artifactId>hibernate-core</artifactId>
                  <version>${hibernate.minimum.version}</version>
                </additionalClasspathDependency>
              </additionalClasspathDependencies>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.hibernate.orm:hibernate-core</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <additionalClasspathDependencies>
                <additionalClasspathDependency>
                  <groupId>org.hibernate.orm</groupId>
                  <artifactId>hibernate-core</artifactId>
                  <version>${hibernate.minimum.version}</version>
                </additionalClasspathDependency>
              </additionalClasspathDependencies>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
